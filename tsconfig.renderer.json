{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ES2022",
        "moduleResolution": "bundler",
        "outDir": "dist/renderer",
        "rootDir": "src/renderer",
        "strict": true,
        "skipLibCheck": true
    },
    "include": [
        "src/renderer/**/*.ts",
        "src/renderer/**/*.d.ts"
    ]
}